{
    "name": "contao/easy-coding-standard",
    "description": "EasyCodingStandard configurations for Contao",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Leo Feyer",
            "homepage": "https://github.com/leofeyer"
        }
    ],
    "require": {
        "php": "^8.2",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.14",
        "slevomat/coding-standard": "^8.30",
        "symplify/easy-coding-standard": "^13.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Contao\\EasyCodingStandard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contao\\EasyCodingStandard\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    },
    "scripts": {
        "all": [
            "@rector",
            "@cs-fixer",
            "@unit-tests",
            "@phpstan"
        ],
        "cs-fixer": "@php vendor/bin/ecs check --fix",
        "phpstan": "@php vendor-bin/phpstan/vendor/bin/phpstan analyze",
        "rector": "@php vendor-bin/rector/vendor/bin/rector",
        "unit-tests": "@php vendor/bin/phpunit"
    }
}
